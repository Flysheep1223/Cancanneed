# 首次启动自动生成 .env 和随机管理员密码；默认匿名访问，无需登录。
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-random-password
GF_SERVER_HTTP_ADDR=127.0.0.1
GF_SERVER_HTTP_PORT=3000

# PostgreSQL 首次部署时自动向 .env 追加配置，三个账号使用不同随机密码。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=metrics
POSTGRES_USER=metrics_writer
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_ADMIN_PASSWORD=replace-with-another-random-password
GRAFANA_POSTGRES_USER=grafana_reader
GRAFANA_POSTGRES_PASSWORD=replace-with-a-third-random-password

# 方舟用量查询的可选配置见 data_ark/.env.example，按需追加到根目录 .env。
