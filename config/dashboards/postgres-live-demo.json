    {
      "id": 12,
      "title": "Token 汇总 · 当前时间范围",
      "description": "缓存 Token 比例 = 命中缓存的输入 Token 总量 / 输入 Token 总量。",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "local-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "local-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  labels->>'model' AS \"模型\",\n  sum(value) FILTER (WHERE metric_name = 'input_tokens') AS \"输入 Token\",\n  sum(value) FILTER (WHERE metric_name = 'output_tokens') AS \"输出 Token\",\n  sum(value) FILTER (WHERE metric_name = 'reasoning_tokens') AS \"推理 Token\",\n  sum(value) FILTER (WHERE metric_name = 'cached_input_tokens')\n    / nullif(sum(value) FILTER (WHERE metric_name = 'input_tokens'), 0) AS \"缓存 Token 比例\"\nFROM public.metric_samples\nWHERE labels->>'source' = 'grafana_demo_v1'\n  AND $__timeFilter(event_time)\n  AND labels->>'model' IN (${model:sqlstring})\nGROUP BY 1 ORDER BY 1;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "缓存 Token 比例"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
