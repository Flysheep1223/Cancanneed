        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "local-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  event_time AS \"采样时间\",\n  labels->>'model' AS \"模型\",\n  max(value) FILTER (WHERE metric_name = 'ttft_ms') AS \"TTFT\",\n  max(value) FILTER (WHERE metric_name = 'e2e_ms') AS \"E2E\",\n  max(value) FILTER (WHERE metric_name = 'output_tokens') AS \"输出 Token\",\n  max(value) FILTER (WHERE metric_name = 'reasoning_tokens') AS \"推理 Token\"\nFROM public.metric_samples\nWHERE labels->>'source' = 'grafana_demo_v1'\n  AND $__timeFilter(event_time)\n  AND labels->>'model' IN (${model:sqlstring})\nGROUP BY 1, 2 ORDER BY 1 DESC, 2\nLIMIT 15;",
          "format": "table"
        }
      ],
