            "type": "grafana-postgresql-datasource",
            "uid": "local-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS value\nFROM public.metric_samples\nWHERE labels->>'source' = 'grafana_demo_v1'\n  AND $__timeFilter(event_time)\n  AND labels->>'model' IN (${model:sqlstring})\n  AND metric_name = 'ttft_ms';",
          "format": "table"
