          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT\n  $__timeGroupAlias(event_time, '$__interval'),\n  labels->>'model' AS metric,\n  avg(value) AS value\nFROM public.metric_samples\nWHERE labels->>'source' = 'grafana_demo_v1'\n  AND $__timeFilter(event_time)\n  AND labels->>'model' IN (${model:sqlstring})\n  AND metric_name = 'reasoning_tokens'\nGROUP BY 1, 2\nORDER BY 1 ASC;",
