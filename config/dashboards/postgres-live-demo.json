        "definition": "SELECT DISTINCT labels->>'model' AS __text, labels->>'model' AS __value\nFROM public.metric_samples\nWHERE labels->>'source' = 'grafana_demo_v1'\nORDER BY 1;",
        "query": "SELECT DISTINCT labels->>'model' AS __text, labels->>'model' AS __value\nFROM public.metric_samples\nWHERE labels->>'source' = 'grafana_demo_v1'\nORDER BY 1;",
