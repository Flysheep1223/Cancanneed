    {
      "id": 2,
      "title": "模拟请求数",
      "description": "当前时间范围、所选模型的模拟请求数。每个请求包含 8 条指标记录。",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "local-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
